# Wardrop Production Environment Variables
# Copy this file to .env and update the values

# PostgreSQL Database
POSTGRES_USER=wardrop
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD
POSTGRES_DB=wardrop

# JWT Secret Key - Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_SECRET_KEY

# Twilio Configuration (optional - for SMS/WhatsApp notifications)
# To set up Twilio:
# 1. Create account at https://console.twilio.com/
# 2. On the dashboard, copy "Account SID" and "Auth Token"
# 3. Go to Phone Numbers > Manage > Active Numbers to get your Twilio phone number
# 4. Phone number must be in E.164 format (e.g., +213555123456)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

